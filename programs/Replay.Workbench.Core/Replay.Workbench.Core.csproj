<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>ReplayWorkbench.Core</RootNamespace>
    <AssemblyName>Replay.Workbench.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Generated by tools/export_core_data.py from docs/*.js. Embedded so the
       app is a single self-contained exe with no data files to lose. -->
  <ItemGroup>
    <EmbeddedResource Include="Data\opcodes.json" />
    <EmbeddedResource Include="Data\patchdiffs.json" />
    <EmbeddedResource Include="Data\afgear.json" />
  </ItemGroup>

</Project>
